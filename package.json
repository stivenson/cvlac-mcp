{
  "name": "cvlac-mcp",
  "version": "1.0.4",
  "description": "Actualiza tu hoja de vida de CvLAC (MinCiencias) conversando con tu asistente de IA, sin llenar formularios a mano. Servidor MCP con Playwright.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cvlac-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/portfolio-extra.example.json",
    "cvlac.config.example.json",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stivenson/cvlac-mcp.git"
  },
  "homepage": "https://github.com/stivenson/cvlac-mcp#readme",
  "bugs": {
    "url": "https://github.com/stivenson/cvlac-mcp/issues"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test:e2e:live": "node tests/e2e/live-crud.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cvlac",
    "minciencias",
    "colciencias",
    "playwright",
    "curriculum",
    "colombia",
    "hoja-de-vida",
    "scienti",
    "gruplac",
    "investigacion",
    "playwright-automation"
  ],
  "author": "Stivenson Rincón Mora",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "playwright": "1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
