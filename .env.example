# CvLAC credentials — the same ones you type at
# https://scienti.minciencias.gov.co/cvlac/Login/pre_s_login.do
# Keep the single quotes: without them a # in the password cuts it short.
CVLAC_NOMBRE='your_first_name_here'
CVLAC_CEDULA='your_id_number_here'
CVLAC_PASSWORD='your_password_here'

# Portfolio site to compare against, if you have one. Also settable as portfolioUrl
# in cvlac.config.json.
# PORTFOLIO_URL='https://your-user.github.io'

# --- Optional ---

# Where the session cookies are cached. Default: .cvlac-session.json in your home.
# Keep it outside the repo and out of synced folders: it opens your CvLAC without a password.
# CVLAC_SESSION_PATH=/home/YOUR_USER/.cvlac-session.json

# Show the browser instead of running headless. Useful to debug form failures.
# CVLAC_HEADLESS=false

# Only for containers where Chromium cannot start with its sandbox. Not recommended.
# CVLAC_NO_SANDBOX=true

# debug | info | warn | error (default: info). Logs always go to stderr.
# CVLAC_LOG_LEVEL=info

# Also append logs to this file.
# CVLAC_LOG_FILE=/tmp/cvlac-mcp.log

# Where this .env itself lives, when the server cannot find it next to itself —
# the case when it is installed from npm and runs out of the npx cache.
# Set it in the editor's MCP config, not here: by the time this file is read it is too late.
# CVLAC_ENV_FILE=/home/YOUR_USER/.config/cvlac-mcp/.env

# Override the default locations of the personal config and curated data.
# CVLAC_CONFIG_PATH=/path/to/cvlac.config.json
# CVLAC_PORTFOLIO_EXTRA_PATH=/path/to/portfolio-extra.json
